<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Configuración de NuGet propia de la solución.
    Se limpian los orígenes heredados de la máquina y se deja únicamente nuget.org,
    de modo que la restauración sea reproducible en cualquier equipo y no dependa
    de repositorios corporativos ni de reglas de mapeo de paquetes externas.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>

</configuration>
