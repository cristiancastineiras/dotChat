<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Chat.Servidor</RootNamespace>
    <AssemblyName>Chat.Servidor</AssemblyName>
    <UserSecretsId>dotchat-servidor-2f4c8a91</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chat.Infraestructura\Chat.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup Label="Escalado horizontal">
    <!-- Reparte los mensajes del hub entre réplicas y comparte el anillo de claves,
         que es lo que permite que cualquiera atienda a cualquier cliente. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup Label="Observabilidad">
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- Una actividad por consulta a PostgreSQL, con el comando ya parametrizado. -->
    <PackageReference Include="Npgsql.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup Label="Rendimiento">
    <!-- ZLogger escribe los registros sin asignar cadenas intermedias; ZLinq proyecta
         el registro de conexiones sin materializar enumeradores en el montículo. -->
    <PackageReference Include="ZLogger" />
    <PackageReference Include="ZLinq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite que el proyecto de pruebas acceda a la clase Program (host de integración). -->
    <InternalsVisibleTo Include="Chat.Tests" />
  </ItemGroup>

</Project>
