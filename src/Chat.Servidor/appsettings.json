{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Chat": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "BaseDatos": "Data Source=chat.db;Cache=Shared;Foreign Keys=True"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7150"
      }
    }
  },
  "Jwt": {
    "Emisor": "dotchat-servidor",
    "Audiencia": "dotchat-clientes",
    "ClaveFirmaBase64": "",
    "MinutosVigenciaAcceso": 30,
    "DiasVigenciaRefresco": 7,
    "SegundosToleranciaReloj": 30
  },
  "Cifrado": {
    "ClaveBase64": "",
    "ContextoAsociado": "dotchat:mensaje:v1",
    "LongitudMaximaMensaje": 2000
  },
  "Cache": {
    "SegundosDuracionPorDefecto": 60,
    "SegundosDuracionUsuarios": 120,
    "SegundosDuracionSalas": 300,
    "SegundosDuracionConfiguracion": 900,
    "SegundosMargenGracia": 3600,
    "SegundosVentanaAntiRepeticion": 120
  },
  "SignalR": {
    "RutaHub": "/hubs/chat",
    "SegundosTiempoEsperaCliente": 60,
    "SegundosIntervaloLatido": 15,
    "SegundosTiempoNegociacion": 15,
    "TamanoMaximoMensajeBytes": 32768,
    "DetallarErrores": false,
    "MaximoMensajesPorMinuto": 60
  },
  "Telemetria": {
    "Activada": true,
    "Protocolo": "grpc",
    "PuntoEntrada": "http://localhost:4317",
    "NombreServicio": "dotchat-servidor",
    "Trazas": true,
    "Metricas": true,
    "Registros": true
  },
  "Administrador": {
    "NombreUsuario": "admin",
    "Email": "admin@dotchat.local",
    "Clave": "",
    "SalaInicial": "General"
  }
}
