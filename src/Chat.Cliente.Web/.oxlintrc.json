{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"pedantic": "off",
		"perf": "warn",
		"style": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"plugins": ["react", "jsx-a11y", "import", "typescript", "unicorn", "vitest"],
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
		"no-console": ["warn", { "allow": ["warn", "error", "info"] }],
		"import/first": "warn",
		"import/no-duplicates": "warn",
		"import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
		"react/react-in-jsx-scope": "off",
		"jsx-a11y/no-autofocus": "off"
	},
	"settings": {
		"react": {
			"version": "19.0"
		},
		"jsx-a11y": {
			"components": {
				"Link": "a",
				"Button": "button"
			}
		}
	},
	"env": {
		"browser": true,
		"es2024": true,
		"node": true
	},
	"globals": {
		"import.meta": "readonly"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.turbo/**",
		"**/coverage/**",
		"**/*.min.js",
		"**/pnpm-lock.yaml",
		"**/.pnpm-store/**",
		"**/*.tsbuildinfo",
		"apps/webapp/src/vite-env.d.ts"
	]
}
