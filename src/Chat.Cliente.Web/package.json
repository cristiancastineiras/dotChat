{
	"name": "dotchat.cliente.web",
	"version": "1.0.0",
	"private": true,
	"description": "Cliente web de dotChat: monorepo React con Vite, Turbo y pnpm",
	"workspaces": [
		"apps/*",
		"paquetes/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:webapp": "turbo run build --filter=webapp",
		"preview": "turbo run preview",
		"lint": "turbo run lint",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "pnpm run lint && pnpm run format:check",
		"typecheck": "turbo run typecheck",
		"clean": "turbo run clean && rimraf node_modules/.cache",
		"clean:all": "rimraf **/node_modules **/dist **/.turbo && pnpm install",
		"prepare": "echo 'Hooks de git listos'",
		"audit": "pnpm audit --audit-level=moderate",
		"deps:check": "pnpm outdated --recursive",
		"deps:update": "pnpm update --recursive --latest"
	},
	"dependencies": {
		"@microsoft/signalr": "^10.0.11",
		"@tailwindcss/postcss": "^4.1.18",
		"@tanstack/react-query": "^5.90.20",
		"@tanstack/react-table": "^8.21.3",
		"antd": "^6.4.4",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"dotenv": "^17.2.3",
		"emoji-picker-react": "^4.15.0",
		"ky": "^1.14.3",
		"lucide-react": "^0.563.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-easy-crop": "^6.2.3",
		"react-error-boundary": "^6.1.0",
		"react-router-dom": "^7.13.0",
		"sonner": "^2.0.7",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"@types/dotenv": "^8.2.3",
		"@types/node": "^25.2.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"autoprefixer": "^10.4.24",
		"dotenv-cli": "^11.0.0",
		"globals": "^17.3.0",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"postcss": "^8.5.6",
		"rimraf": "^6.1.2",
		"rolldown": "^1.1.2",
		"tailwindcss": "^4.1.18",
		"tsdown": "^0.22.3",
		"turbo": "^2.8.1",
		"typescript": "~5.9.3",
		"vite": "^8.1.0",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"engines": {
		"node": ">=24.11.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.28.2",
	"pnpm": {
		"overrides": {
			"postcss@<8.4.31": ">=8.4.31"
		}
	}
}
