<Project>

  <!--
    Gestión centralizada de versiones de paquetes NuGet (Central Package Management).
    Cada .csproj declara únicamente <PackageReference Include="..." /> sin versión.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Entity Framework Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.10" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <!--
    Proveedor de PostgreSQL. Se usa el servidor relacional como única fuente de
    verdad: tipos nativos (uuid, timestamptz, bytea), índices parciales reales y
    concurrencia de escritura, que es lo que exige un chat multiusuario.
  -->
  <ItemGroup Label="PostgreSQL">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <!--
    Almacenamiento de objetos. Se usa el SDK de S3 y no el cliente propio de MinIO:
    el protocolo es el mismo, y así el día que el almacén deje de ser MinIO y pase a
    ser S3, Ceph o cualquier otro compatible, solo cambia la configuración.
  -->
  <ItemGroup Label="Almacenamiento de objetos">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102" />
  </ItemGroup>

  <!--
    Piezas que hacen posible ejecutar varias réplicas del servidor: el canal que
    reparte los mensajes de SignalR entre ellas y el anillo de claves compartido,
    sin el cual cada réplica cifraría con claves distintas.
  -->
  <ItemGroup Label="Escalado horizontal">
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.10" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Extensiones de host y configuración">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <!--
    Caché en dos niveles: memoria del proceso (L1) sobre Valkey (L2), con un canal
    de retropropagación que mantiene coherentes las réplicas. Valkey habla el
    protocolo de Redis, así que se usa el cliente estándar StackExchange.Redis.
  -->
  <ItemGroup Label="Caché">
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageVersion Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup Label="Interfaz de línea de comandos">
    <PackageVersion Include="Spectre.Console" Version="0.55.0" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="Spectre.Console.ImageSharp" Version="0.55.0" />
  </ItemGroup>

  <!--
    Tratamiento de imágenes. El servidor la usa para validar, normalizar y limitar
    lo que se sube; el cliente, para convertir la imagen en bloques de color que la
    consola sabe pintar.
  -->
  <ItemGroup Label="Imágenes">
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!--
    Librerías de Cysharp orientadas a rendimiento: se usan en las rutas calientes
    (registro de eventos, proyecciones en memoria, composición de cadenas) para
    evitar asignaciones en el montículo y, con ellas, presión sobre el recolector.
  -->
  <ItemGroup Label="Rendimiento (Cysharp)">
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <PackageVersion Include="ZLinq" Version="1.5.4" />
    <PackageVersion Include="ZString" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup Label="Observabilidad (OpenTelemetry)">
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
  </ItemGroup>

</Project>
